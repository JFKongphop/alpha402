# --- Hedera operator: mints subscription passes, writes HCS receipts, settles ---
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=                 # ECDSA private key
# Durable HCS receipt topic (auto-created if unset; paste it back to reuse)
HEDERA_TOPIC_ID=
# Durable HTS pass tokens per feed (auto-created if unset; paste back to reuse)
# FEED_TOKEN_ALPHA_BRIEF=0.0.xxxxx

# --- x402 settlement (Hedera via the Blocky402 facilitator) ---
FACILITATOR_URL=https://api.testnet.blocky402.com
# Payout wallet advertised to buyers (per-call feeds settle here)
WALLET=0.0.xxxxx

# --- The demo buying agent (pays the period fee, receives the pass) ---
HEDERA_CLIENT_ID=0.0.xxxxx
HEDERA_CLIENT_KEY=

# --- Data sources ---
GRAPH_API_KEY=                     # The Graph gateway / Subgraph Studio key (REQUIRED: live data)
UNISWAP_API_KEY=                   # Uniswap Trading API key (live prices + invest quotes/swaps)

# --- AI summarizer (writes the alpha-brief) — provider-agnostic, pick one ---
LLM_PROVIDER=openai                # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Text-to-speech (Paxa Labs) — optional, voices the agent + brief ---
PAXA_API_KEY=

# --- Uniswap investment (the agent's EVM wallet swaps on Unichain Sepolia) ---
EVM_AGENT_PRIVATE_KEY=             # a THROWAWAY EVM key, funded with testnet ETH + USDC only
EVM_CHAIN_ID=1301                  # Unichain Sepolia
# The default public RPC accepts txs but never mines them (tx.wait hangs) — use a reliable one:
EVM_RPC=https://unichain-sepolia-rpc.publicnode.com

# --- Server ---
PORT=4021
